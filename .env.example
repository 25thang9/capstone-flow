# Neon PostgreSQL: pooled URL for application requests
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Neon PostgreSQL: direct URL for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
# At least 32 random characters, never publish this value
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Only used by npm run db:seed, remove after seeding if desired
SEED_LECTURER_PASSWORD="REPLACE_WITH_A_PRIVATE_DEMO_PASSWORD"
