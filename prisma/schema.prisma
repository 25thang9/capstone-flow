generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TopicStatus {
  OPEN
  CLOSED
}

enum RegistrationStatus {
  NEW
  CONTACTED
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(150)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  topics       Topic[]
  sessions     Session[]

  @@map("users")
}

model Topic {
  id            Int           @id @default(autoincrement())
  lecturerId    Int           @map("lecturer_id")
  title         String        @db.VarChar(255)
  description   String
  objectives    String?
  requirements  String?
  technologies  String?
  maxStudents   Int           @default(1) @map("max_students")
  status        TopicStatus   @default(OPEN)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lecturer      User          @relation(fields: [lecturerId], references: [id])
  registrations Registration[]

  @@index([lecturerId])
  @@index([status])
  @@map("topics")
}

model Registration {
  id           Int                @id @default(autoincrement())
  topicId      Int                @map("topic_id")
  studentName  String             @map("student_name") @db.VarChar(150)
  studentCode  String?            @map("student_code") @db.VarChar(30)
  studentEmail String             @map("student_email") @db.VarChar(255)
  studentPhone String             @map("student_phone") @db.VarChar(20)
  studentClass String?            @map("student_class") @db.VarChar(100)
  message      String?
  readAt       DateTime?          @map("read_at")
  messageReadAt DateTime?         @map("message_read_at")
  status       RegistrationStatus @default(NEW)
  createdAt    DateTime           @default(now()) @map("created_at")
  topic        Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, studentEmail])
  @@index([topicId])
  @@index([readAt])
  @@map("registrations")
}

model Session {
  id        String   @id @db.VarChar(255)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
